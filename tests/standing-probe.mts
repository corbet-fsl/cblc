// Proves the Noir standing transitions and policy digest equal the czkp integer oracle
// (tests/vectors/standing/golden.json, generated by czkp's standing_ref.py). Witness
// execution only: no proof and no member data.
import assert from 'node:assert/strict';
import {readFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import {compile,createFileManager} from '@noir-lang/noir_wasm';
import {Noir} from '@noir-lang/noir_js';

// Poseidon2 digest of the default parameters under the core domain; czkp pins the same value.
const DEFAULT_DIGEST: string|undefined = undefined;
const golden=JSON.parse(await readFile(resolve('tests/vectors/standing/golden.json'),'utf8'));
const compiled=await compile(createFileManager(resolve('circuits/extensions/standing_probe')));
assert.ok(compiled.program?.bytecode,'standing probe compiles');
const noir=new Noir(compiled.program as any);
const s=(n:number|bigint)=>String(n);
const OPS:Record<string,number>={day:0,recv:1,give:2,miss:3,credit:4,punished:5,punish_given:6};
const policyInput=(set:any)=>{const p=set.params;return {
  c0:s(p.c0),h_a:s(p.h_A),h_g:s(p.h_G),n_half:s(p.n_half),n_c:s(p.n_c),e_q:s(p.e_q),r_max:s(p.r_max),r_age:s(p.r_age),
  c_max_q:s(p.c_max_q),c_vet:s(p.c_vet),age_vet:s(p.age_vet),boost_q:s(p.boost_q),boost_days:s(p.boost_days),
  slope_q:s(p.slope_q),mid_q:s(p.mid_q),kappa_q:s(p.kappa_q),loan_use_q:s(p.loan_use_q),factor:s(set.factor),
  trust:set.trust.map(s),g_table:set.g_table.map(s),a_table:set.a_table.map(s)};};
const stateInput=(v:any)=>({g:s(v.G),a:s(v.A),c:s(v.C),pr:s(v.Pr),pg:s(v.Pg),lc:s(v.Lc),day:s(v.day)});
let digests=new Map<string,string>();
let steps=0;
for(const [name,set] of Object.entries<any>(golden.sets)) {
  const policy=policyInput(set);
  let state={G:0,A:set.a0_q,C:0,Pr:0,Pg:0,Lc:0,day:0,joined:0};
  for(const [script,list] of Object.entries<any>(set.scripts)) {
    state={G:0,A:set.a0_q,C:0,Pr:0,Pg:0,Lc:0,day:0,joined:0};
    for(const step of list) {
      const [op,arg]=step.step;
      const out=await noir.execute({policy,joined:'0',state:stateInput(state),op:s(OPS[op]),arg:s(arg),
        next:stateInput(step.state),expected_cap:s(step.cap)});
      digests.set(name,String(out.returnValue));
      state=step.state;steps++;
    }
  }
}
assert.ok(steps>100);
// A wrong expected cap or a tampered table entry must not execute.
const set=golden.sets.default;const first=set.scripts.sociable[0];
const base={policy:policyInput(set),joined:'0',state:stateInput({G:0,A:set.a0_q,C:0,Pr:0,Pg:0,Lc:0,day:0}),
  op:s(OPS[first.step[0]]),arg:s(first.step[1]),next:stateInput(first.state),expected_cap:s(first.cap)};
await noir.execute(base);
await assert.rejects(()=>noir.execute({...base,expected_cap:s(first.cap+1)}));
await assert.rejects(()=>noir.execute({...base,next:{...base.next,g:s(1)}}));
const tampered=policyInput(set);tampered.trust[0]=s(1);
await assert.rejects(()=>noir.execute({...base,policy:tampered}));
const distinct=new Set(digests.values());
assert.equal(distinct.size,digests.size,'each parameter set has its own digest');
console.log(`standing probe: ${steps} steps; default digest ${digests.get('default')}`);
if(DEFAULT_DIGEST!==undefined) assert.equal(digests.get('default'),DEFAULT_DIGEST);
