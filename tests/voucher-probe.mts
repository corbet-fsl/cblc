// Proves the Noir voucher allowance, admission and bond-address derivations equal czkp
// (tests/vectors/voucher/golden.json, generated by czkp's tests/voucher.rs). Witness
// execution only: no proof and no member data.
import assert from 'node:assert/strict';
import {readFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import {compile,createFileManager} from '@noir-lang/noir_wasm';
import {Noir} from '@noir-lang/noir_js';
import {policyInput} from './support/standing-input.mts';

const golden=JSON.parse(await readFile(resolve('tests/vectors/voucher/golden.json'),'utf8'));
const standing=JSON.parse(await readFile(resolve('tests/vectors/standing/golden.json'),'utf8'));
const compiled=await compile(createFileManager(resolve('circuits/extensions/voucher_probe')));
assert.ok(compiled.program?.bytecode,'voucher probe compiles');
const noir=new Noir(compiled.program as any);
const policy=policyInput(standing.sets.default);
const s=(n:number|bigint)=>String(n);
const bytes=(h:string)=>Array.from(Buffer.from(h.slice(2),'hex')).map(String);
// Fields of the probe output in order.
const KEYS=['limit','remaining','weight','rewarded','away','lost','entry_limit','overshoot','tag','commit','key','entry','member_tag'];
const input=(c:any,over:any={})=>({policy,role:s(c.role),
  v:{proven:s(c.account.proven),away:s(c.account.away),lost:s(c.account.lost),bonus:s(c.account.bonus),
     returned:'0',answers:'0',sponsor:'0',bond:'0',bond_root:'0',bond_count:'1'},
  cap:s(c.cap),bond:bytes(c.bond),community:bytes(c.community),member:bytes(c.member),kind:s(c.kind),n:s(c.n),
  weight_limit:s(c.weight_limit),...over});
let checked=0;
for(const c of golden.cases) {
  const out=(await noir.execute(input(c))).returnValue as string[];
  KEYS.forEach((key,i)=>{
    const want=c.expect[key];
    const got=BigInt(out[i]);
    assert.equal(got,BigInt(want),`${key} for role ${c.role} cap ${c.cap} account ${JSON.stringify(c.account)}`);
  });
  checked++;
}
assert.ok(checked>=100);
// An unknown role must not execute.
await assert.rejects(()=>noir.execute(input(golden.cases[0],{role:'3'})));
console.log(`voucher probe: ${checked} cases`);
