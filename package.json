{
  "name": "cblc-validation",
  "private": true,
  "type": "module",
  "workspaces": [
    "runtime/accounting",
    "experiments/private-accounting"
  ],
  "dependencies": {
    "@corbet-labs/czkp": "github:corbet-foss/czkp#main",
    "@corbet-labs/cwlt": "github:corbet-foss/cwlt#main"
  },
  "scripts": {
    "test": "node --test tests/holder/test/*.test.mjs tests/runtime/*.test.ts",
    "coverage:runtime:report": "c8 report"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  },
  "c8": {
    "all": true,
    "src": [
      "runtime"
    ],
    "include": [
      "runtime/**/*.mjs",
      "runtime/**/*.ts"
    ],
    "exclude": [],
    "extension": [
      ".mjs",
      ".ts"
    ],
    "reporter": [
      "text",
      "json",
      "json-summary",
      "lcov"
    ],
    "reports-dir": "runtime-coverage",
    "temp-directory": ".runtime-v8"
  }
}
